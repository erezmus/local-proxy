PROXY_NETWORK=local-proxy

# Address the published ports bind to. 127.0.0.1 keeps the proxy on this machine.
# Set a LAN IP to make it reachable from other devices. See the Security section of README.md first.
PROXY_BIND=127.0.0.1

# UID and GID that Traefik runs as. They must own certs/local-key.pem (mode 600). Find them with `id -u` / `id -g`.
PROXY_UID=1000
PROXY_GID=1000
