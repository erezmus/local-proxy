#!/usr/bin/env sh
# Pre-commit hook; enable once per clone with: git config core.hooksPath .githooks (see README.md).
set -eu

cd "$(git rev-parse --show-toplevel)"

shellcheck regen-certs.sh
docker compose config --quiet

# Fail if .env is tracked or is not ignored.
git check-ignore -q .env || {
  echo ".env must be untracked and git-ignored" >&2
  exit 1
}

# Scan staged changes only. Full-history scans are run manually or in CI.
gitleaks git --pre-commit --redact
